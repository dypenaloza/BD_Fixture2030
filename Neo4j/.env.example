# ---------------------------------------------------------------------------
# Credenciales y puertos del ambiente LOCAL de desarrollo (RNF8).
#
# Uso:  cp .env.example .env      (Windows PowerShell: copy .env.example .env)
#
# Estos valores son de desarrollo local y descartables: no son secretos
# reales ni contraseñas personales de ningún integrante. El archivo .env
# está excluido del repositorio por .gitignore.
# ---------------------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=fixture2030

# Puertos publicados en la notebook. Cambiarlos sólo si 7474/7687 están
# ocupados por otro servicio (ver sección de diagnóstico del README).
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
