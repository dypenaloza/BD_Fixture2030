# 
# ======================================================================
# 2. CACHE DE RESULTADO DE PARTIDO (RF6/RF7)
# Fuente de verdad: Neo4j (nodo :Partido). TTL corto (45s) porque
# es un dato que cambia mientras el partido está en curso -- ver
# docs/ciclo_de_vida_e_invalidacion.md.
# ======================================================================
SET cache:partido:P-A-1 "{\"golesLocal\":1,\"golesVisitante\":2,\"estado\":\"finalizado\"}" EX 45
SET cache:partido:P-A-3 "{\"golesLocal\":2,\"golesVisitante\":1,\"estado\":\"finalizado\"}" EX 45
SET cache:partido:P-E-4 "{\"golesLocal\":0,\"golesVisitante\":0,\"estado\":\"en_juego\"}" EX 45
SET cache:partido:P-QF-2 "{\"golesLocal\":3,\"golesVisitante\":1,\"estado\":\"finalizado\"}" EX 45
SET cache:partido:P-R16-3 "{\"golesLocal\":2,\"golesVisitante\":1,\"estado\":\"finalizado\"}" EX 45
SET cache:partido:P-R32-6 "{\"golesLocal\":1,\"golesVisitante\":0,\"estado\":\"en_juego\"}" EX 45
# 
# ======================================================================
# 3. CONTADOR DE VISITAS Y ENCUESTA DE FIGURA (RF8/RF9)
# INCRBY simula visitas ya acumuladas antes de la demo en vivo.
# ZADD precarga votos de la encuesta; en la demo se agregan mas
# con ZINCRBY para mostrar la actualizacion atomica concurrente.
# ======================================================================
SET contador:partido:P-A-1:visitas 3383
ZADD encuesta:P-A-1:figura 66 "ARG-10"
ZADD encuesta:P-A-1:figura 43 "ARG-09"
ZADD encuesta:P-A-1:figura 32 "ESP-07"
ZADD encuesta:P-A-1:figura 57 "ESP-11"
SET contador:partido:P-A-3:visitas 3136
ZADD encuesta:P-A-3:figura 36 "ARG-10"
ZADD encuesta:P-A-3:figura 22 "ARG-07"
ZADD encuesta:P-A-3:figura 9 "ESP-09"
