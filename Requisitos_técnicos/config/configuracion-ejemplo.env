# Copiar a config/.env (o exportar estas variables en la shell antes de
# correr el script) y completar con los valores reales del entorno
# local. No commitear el archivo con valores reales: ver config/.gitignore.

# API integrada del Hito 10
API_URL=http://127.0.0.1:8000
CONNECT_TIMEOUT=3
API_TIMEOUT=5

# MongoDB
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=fixture2030
MONGO_USER=admin
MONGO_PASSWORD=

# Neo4j
NEO4J_HOST=127.0.0.1
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Cassandra
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fixture2030

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# InfluxDB 3 Core
INFLUX_URL=http://127.0.0.1:8181
INFLUX_HOST=127.0.0.1
INFLUX_PORT=8181

# InterSystems IRIS
IRIS_HOST=127.0.0.1
IRIS_PORT=1972
IRIS_PORTAL_URL=http://127.0.0.1:52773
